# Copy to .env and fill in. Never commit .env.
# AI provider (OpenAI-compatible /chat/completions). Leave empty to use rules only.
# Gemini (free tier): AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-3.5-flash-lite (tested 26 Nov 2026: 1-3 s, tool calls and JSON work; gemini-flash-latest returned 503)
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite
# Mock server options (contracts/mock-server.js)
PORT=8080
# LIVE=1 pulls real job posts from Agoda's public Greenhouse board (free, no key; Bangkok rows only, office jobs).
# No free API exists for Department of Employment job listings (data.go.th has statistics only, checked 26 Nov 2026).
LIVE=1
# ThaID mock (app home "เชื่อม ThaID" bypasses the real sign-in and uses sample records labelled mock)
GOV_CONNECTED=1
# Broad mock catalogue (fixtures/opportunities-mock.json): mock adapters for government and private sources
MOCK_CATALOGUE=1
DEMO_MODE=1
INTEGRATION_KEY=
GIT_COMMIT=
# Storage and jobs (ADR-001). npm run mock uses contracts/.data/ when these are empty.
DATA_FILE=
AI_LOG_FILE=
# AI calls per device per day before rules are used (0 = no limit)
AI_DAILY_LIMIT=50
# Hours between Greenhouse/Lever pulls when LIVE=1
SOURCE_REFRESH_HOURS=6
# Retention (config, set later): devices not seen for N days are archived or deleted. 0 = off
RETENTION_DAYS=0
# archive = move profile + activity to ARCHIVE_FILE (ThaID identity is never archived); delete = remove
RETENTION_MODE=archive
# Default: DATA_FILE + .archive.jsonl
ARCHIVE_FILE=
